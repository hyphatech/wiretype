; One value describes a shape, reads it, writes it and says what it is -- to
; a JSON Schema, to zod, or to anybody who walks it. It depends on Ptime,
; Mtime and Uuidm alone, the types an instant, a duration and a UUID are.

(library
 (name wiretype)
 (public_name wiretype)
 (libraries ptime mtime uuidm)
 (modules_without_implementation shape)
 (private_modules
  grammar
  bounds
  decode
  encode
  itself
  powers
  idna_data
  melange_prelude))

; What every printed Melange module opens with, kept as the OCaml it is in
; melange/ and carried here as text.

(rule
 (target melange_prelude.ml)
 (deps melange/prelude.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let text = {prelude|")
    (cat melange/prelude.ml)
    (echo "|prelude}\n")))))

; The Unicode properties an internationalised host is checked by, from
; Unicode 15.0.0's own files in unicode/.

(rule
 (target idna_data.ml)
 (deps
  (glob_files unicode/*.txt))
 (action
  (with-stdout-to
   %{target}
   (run gen/idna.exe unicode))))

; The powers of ten the double printer reads, as exact 126-bit integers.

(rule
 (target powers.ml)
 (action
  (with-stdout-to
   %{target}
   (run gen/powers.exe))))
